# Copiar a .env (ignorado). El runtime .NET no carga .env automáticamente.
ASPNETCORE_ENVIRONMENT=Demo
ASPNETCORE_URLS=http://0.0.0.0:5080
ConnectionStrings__SqlServer='Server=localhost,1433;Database=FarmeORTDemo;User Id=farmeort_app;Password=REEMPLAZAR;Encrypt=True;TrustServerCertificate=True'
Auth__SessionMinutes=120
Cors__Origins=http://localhost:4200
Demo__Enabled=true
# Solo localhost en entorno Demo. En Azure usar false y TrustServerCertificate=False.
Demo__AllowLocalUntrustedCertificate=true
# Credenciales ficticias públicas, únicamente para un entorno de demo aislado.
Demo__OrganizerPassword='OrganizadorDemo123!'
Demo__RivalPassword='RivalDeDemo12345!'
